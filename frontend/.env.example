# Copy to frontend/.env.local only when the backend address differs.
# Server-side proxy target; this is NOT a browser-exposed variable.
# Rebuild the frontend after changing this for production.
BACKEND_URL=http://127.0.0.1:8000

# Android builds call FastAPI directly (no Next.js proxy in the APK).
# Prefer setting this in the shell for android:sync, leaving website builds alone.
# This is a public build-time address, never a secret. Do not append /api.
# Android Studio emulator: http://10.0.2.2:8000 (the build script's default)
# Physical phone: http://YOUR_PC_LAN_IP:8000 (backend must listen on 0.0.0.0)
# Release: https://your-backend.example.com (use android:sync:release)
# NEXT_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
