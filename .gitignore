# University source prose and derived research artifacts remain local-only.
# Do not make exceptions for real-program exports, RAG text or quality reports.
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/sources/*
!/data/sources/.gitkeep

# Historical reports contain local source extracts or profile-derived context.
