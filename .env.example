# Copy to .env at the project root. Never commit the resulting .env.
# Local Python defaults to SQLite. Uncomment to use your own PostgreSQL database.
# DATABASE_URL=postgresql+psycopg://lifepilot:YOUR_PASSWORD@localhost:5432/lifepilot
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://localhost"]
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_SECONDS=60

# Docker Compose development database. Change the example before shared use.
POSTGRES_DB=lifepilot
POSTGRES_USER=lifepilot
POSTGRES_PASSWORD=lifepilot_local_change_me
# Compose replaces OLLAMA_BASE_URL inside the backend with this host URL.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
